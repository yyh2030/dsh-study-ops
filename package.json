{
  "name": "@local/study-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "实验运行台：被试进度、DDT/IDM 数据质检、随访提醒",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "scan.js",
    "qc.py",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
