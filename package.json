{
  "name": "@local/study-ops",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "配置驱动的研究运行台：参与者、访视任务、异常与预约随访",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "generic-scan.mjs",
    "csv.mjs",
    "state-store.mjs",
    "study-context.mjs",
    "study-selection.mjs",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "minVersion": "0.2.2-rc.1"
  }
}
